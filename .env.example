# Copy this file to .env for local scripts. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit real values.

# Required: token from @BotFather (looks like 123456789:ABC...)
TELEGRAM_BOT_TOKEN=

# Required: a random string you invent (A-Z, a-z, 0-9, _ and - only, up to 256 chars).
# Telegram sends it back on every webhook call so the endpoint can reject forged requests.
TELEGRAM_WEBHOOK_SECRET=

# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model name. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Recommended: comma-separated Telegram user IDs allowed to use the bot (your own ID).
# Leave empty to allow anyone who finds the bot (they would spend your Gemini quota).
# Send /id to the bot to find a user's ID.
ALLOWED_TELEGRAM_USER_IDS=

# Optional: maximum length of a note in characters. Defaults to 8000.
MAX_NOTE_CHARS=
